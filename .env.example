# Copy this file to .env and fill in local paths / credentials.

# Minecraft dump directory, containing files such as advitempanel.json,
# itemicon.json, fluid.json, icons/, and image_redirect.csv.
DUMPS_DIR=E:\Path\To\PrismLauncher\instances\GT_New_Horizons\.minecraft\dumps

# HuijiWiki MediaWiki API endpoint.
BASE_URL=https://gtnh.huijiwiki.com/api.php

# HuijiWiki auth key, if required by the target wiki.
AUTHKEY=

# Normal editor account used by wiki.py.
EDITOR_USERNAME=
EDITOR_PASSWORD=

# Bot account used by batch upload scripts.
BOT_USERNAME=
BOT_PASSWORD=
